{
  "name": "graycloak-adnd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "firebase-functions.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "serve": "npx --yes http-server public -p 8000 -c-1",
