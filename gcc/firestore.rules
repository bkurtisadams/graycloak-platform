// Firestore Security Rules for GCC / Graycloak AD&D / Traveller v14
// v14 gives a Traveller campaign a home: travellerCampaigns/{id}/state/current
//   is the whole campaign as a bundle, referee-only, and a referee may list
//   the campaigns they own so the lobby can offer them.
//
// v13 adds the player's own Traveller characters and the way to a table:
//   travellerCharacters/{id} — owned by the account that rolled it; only the
//     referee of the campaign it is leaving, or of one its owner has asked to
//     join, may change where it is, and they may change nothing else.
//   travellerCampaigns/{id}/joins/{uid} — a request to sit down, create-only
//     by the player redeeming a valid invite code for that campaign, read and
//     cleared by the referee, withdrawable by the player. Traveller invites
//     use the platform's invites/{code} collection unchanged.
//
// v12 adds per-player Traveller documents beneath the seat:
//   travellerCampaigns/{id}/players/{uid}/characters/{characterId} and
//   travellerCampaigns/{id}/players/{uid}/log/current — referee-written copies
//   that only that account and the referee may read.
// v11 adds Graycloak Traveller: travellerCampaigns, with the encounter
//   document referee-only, a player-safe view published by the referee, and
//   declarations writable only by the account that owns that combatant.
//
// v10 authority hardening:
//   - campaigns.worldTick/worldRevision are server-authoritative.
//   - character travel/runtime/identity fields are immutable to all clients after create.
//   - new character docs must begin unbound and cannot inject movement authority fields.
//   - activities/ and events/ are trusted-runtime-only collections.
//
// Admin SDK / server client libraries bypass Firestore Security Rules and are the
// intended write path for authoritative MMO state transitions.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function isGM() {
      return isAuthed()
        && exists(/databases/$(database)/documents/gms/$(request.auth.uid));
    }

    function isCampaignOwner(cid) {
      return isAuthed()
        && get(/databases/$(database)/documents/campaigns/$(cid)).data.ownerUid
           == request.auth.uid;
    }

    // worldTick is the authoritative shared time frontier. worldRevision is
    // reserved for future optimistic-concurrency/version checks. Browser writes
    // may edit other campaign fields but cannot alter either authority field.
    function campaignAuthorityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['worldTick', 'worldRevision']);
    }

    // These fields affect Actor identity, temporal availability, physical
    // position, or authoritative movement. They may only be changed through a
    // trusted Admin/server path (which bypasses Security Rules).
    function actorAuthorityFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'id',
        'documentType',
        'type',
        'ownerUid',
        'campaignId',
        'currentLocation',
        'runtime',
        'movementRate',
        'movement',
        'movementProfile',
        'travelMovementProfile'
      ]);
    }

    function validClientCharacterCreate() {
      return isAuthed()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.campaignId is string
        && request.resource.data.documentType == 'actor'
        && request.resource.data.type == 'character'
        && request.resource.data.runtime is map
        && request.resource.data.runtime.keys().hasAll([
          'lastResolvedTick', 'availableAtTick', 'activityId'
        ])
        && request.resource.data.runtime.lastResolvedTick == null
        && request.resource.data.runtime.availableAtTick == null
        && request.resource.data.runtime.activityId == null
        && !request.resource.data.keys().hasAny([
          'movementRate',
          'movement',
          'movementProfile',
          'travelMovementProfile'
        ]);
    }

    // ── User-private synced data ───────────────────────────────
    match /users/{userId}/data/{document=**} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    match /users/{userId}/lists/{listKey} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
      match /items/{itemId} {
        allow read: if isAuthed();
        allow write: if isAuthed() && request.auth.uid == userId;
      }
    }

    // ── Invites ────────────────────────────────────────────────
    match /invites/{code} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAuthed()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ── Campaigns ──────────────────────────────────────────────
    match /campaigns/{campaignId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data))
        && campaignAuthorityFieldsUnchanged();
      allow delete: if isAuthed()
        && (resource.data.ownerUid == request.auth.uid
            || !('ownerUid' in resource.data));

      // Player roster: owner can manage all, players can add/read themselves.
      match /players/{playerId} {
        allow read: if isAuthed();
        allow create, update: if isAuthed()
          && (request.auth.uid == playerId
              || get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid
                 == request.auth.uid);
        allow delete: if isAuthed()
          && get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerUid
             == request.auth.uid;
      }

      // Table feed: dice rolls + chat messages.
      match /rolls/{rollId} {
        allow read: if isAuthed();
        allow create: if isAuthed()
          && request.resource.data.uid == request.auth.uid
          && (!('text' in request.resource.data)
              || request.resource.data.text.size() <= 2000);
        allow delete: if isAuthed()
          && (resource.data.uid == request.auth.uid
              || isCampaignOwner(campaignId)
              || isGM());
      }

      // Player-safe map state published by the GM client.
      match /maps/{mapId} {
        allow read: if isAuthed()
          && (isCampaignOwner(campaignId)
              || exists(/databases/$(database)/documents/campaigns/$(campaignId)/players/$(request.auth.uid)));
        allow write: if isAuthed() && isCampaignOwner(campaignId);
      }

      // Battle board snapshots and legacy multiplayer command intents.
      match /battles/{battleId} {
        allow read: if isAuthed();
        allow write: if isAuthed()
          && (isCampaignOwner(campaignId) || isGM());

        match /commands/{commandId} {
          allow read: if isAuthed();
          allow create: if isAuthed()
            && request.resource.data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if isAuthed()
            && (isCampaignOwner(campaignId) || isGM()
                || resource.data.uid == request.auth.uid);
        }
      }
    }

    // ── Graycloak Traveller ────────────────────────────────────
    // A Traveller campaign is one document owned by its referee. Players are
    // listed in the shared campaigns/{id}/players roster by uid, so a Traveller
    // seat and an AD&D seat are the same account.
    //
    // Three collections, because Firestore rules grant access per document and
    // cannot filter fields: the encounter itself carries enemy characteristics
    // and wounds, so players must not read it at all. They read a projection
    // the referee publishes, and write only their own declarations.

    // Every lookup below is guarded. Firestore evaluates a write's rules more
    // than once, and in at least one of those passes the campaign document or
    // request.resource may not be readable — dotting into either then raises,
    // and Firestore reports the raise as a denial. Denials that arrive by
    // exception are indistinguishable in the logs from real ones, so each
    // access checks existence first and each field read carries a default.
    function travellerCampaignExists(campaignId) {
      return exists(/databases/$(database)/documents/travellerCampaigns/$(campaignId));
    }

    function travellerRefereeUid(campaignId) {
      return get(/databases/$(database)/documents/travellerCampaigns/$(campaignId))
        .data.get('ownership', {}).get('ownerUid', '');
    }

    function isTravellerReferee(campaignId) {
      return isAuthed()
        && travellerCampaignExists(campaignId)
        && travellerRefereeUid(campaignId) == request.auth.uid;
    }

    function isTravellerPlayer(campaignId) {
      return isAuthed()
        && exists(/databases/$(database)/documents/travellerCampaigns/$(campaignId)/players/$(request.auth.uid));
    }

    // What the write claims, without raising when the field is absent.
    function declarationField(field) {
      return request.resource != null
        ? request.resource.data.get(field, '')
        : '';
    }

    function isAtTravellerTable(campaignId) {
      return isTravellerReferee(campaignId) || isTravellerPlayer(campaignId);
    }

    // Ownership of one combatant. Map.get(key, default) returns the default
    // rather than raising when the key is absent, so an unowned combatant
    // denies by comparison instead of by evaluation error — and it reads the
    // campaign document once rather than twice.
    function ownsTravellerCombatant(campaignId, combatantId) {
      return isAuthed()
        && travellerCampaignExists(campaignId)
        && get(/databases/$(database)/documents/travellerCampaigns/$(campaignId))
             .data.get('ownership', {}).get('actors', {}).get(combatantId, '') == request.auth.uid;
    }

    // v13: does this code open a seat at this campaign? A missing document
    // denies by exists() rather than by evaluation error.
    function travellerInviteOpens(code, campaignId) {
      return code is string
        && code != ''
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.get('game', '') == 'traveller'
        && get(/databases/$(database)/documents/invites/$(code)).data.get('campaignId', '') == campaignId;
    }

    // The referee of the campaign a character's world names. An unassigned
    // world carries null in campaignId, which would raise inside a path, so
    // the type is checked first and && short-circuits.
    function isTravellerRefereeOfWorld(world) {
      return world.get('campaignId', '') is string
        && world.get('campaignId', '') != ''
        && isTravellerReferee(world.get('campaignId', ''));
    }

    // Has this account asked to sit this character down at this campaign?
    // A referee may only pull a character into their world on the strength of
    // the owner's own request; without this, any referee could claim any
    // character.
    function travellerJoinRequested(campaignId, uid, characterId) {
      return campaignId is string && campaignId != ''
        && uid is string && uid != ''
        && exists(/databases/$(database)/documents/travellerCampaigns/$(campaignId)/joins/$(uid))
        && get(/databases/$(database)/documents/travellerCampaigns/$(campaignId)/joins/$(uid)).data.get('characterId', '') == characterId;
    }

    match /travellerCampaigns/{campaignId} {
      // The campaign document holds the party, the ship, the world state and
      // the ownership map. Everyone at the table reads it; only the referee
      // writes it.
      allow get: if isAtTravellerTable(campaignId);
      // v14: a referee lists the campaigns they own; the query must say so.
      allow list: if isAuthed()
        && resource.data.get('ownership', {}).get('ownerUid', '') == request.auth.uid;
      allow create: if isAuthed()
        && request.resource != null
        && request.resource.data.get('ownership', {}).get('ownerUid', '') == request.auth.uid;
      allow update, delete: if isTravellerReferee(campaignId);

      // v14: the campaign's home. The whole bundle — every enemy statistic,
      // situation secret and referee note — so nobody but the referee.
      match /state/{stateId} {
        allow read, write: if isTravellerReferee(campaignId);
      }

      // Who sits at this table. The referee admits and removes; a player may
      // read the roster and update nothing but their own seat.
      match /players/{playerUid} {
        allow read: if isAtTravellerTable(campaignId);
        allow create, delete: if isTravellerReferee(campaignId);
        allow update: if isTravellerReferee(campaignId)
          || (isAuthed() && request.auth.uid == playerUid);

        // The player's own documents, beneath their seat. The character sheet
        // in full and a log filtered to table knowledge, both written by the
        // referee's client. Rules cannot filter fields, so the split between
        // players is by path: only the seated account and the referee may
        // read here, and a seat that is gone takes its documents with it in
        // the rule as well as in the client.
        match /characters/{characterId} {
          allow read: if isTravellerReferee(campaignId)
            || (isAuthed() && request.auth.uid == playerUid && isTravellerPlayer(campaignId));
          allow write: if isTravellerReferee(campaignId);
        }

        match /log/{logId} {
          allow read: if isTravellerReferee(campaignId)
            || (isAuthed() && request.auth.uid == playerUid && isTravellerPlayer(campaignId));
          allow write: if isTravellerReferee(campaignId);
        }
      }

      // v13: a request to sit down. A player creates one for themselves by
      // redeeming a valid Traveller invite for this campaign, may withdraw it,
      // and may not revise it. The referee reads and clears. The requester
      // need not be seated — that is the point of the request.
      match /joins/{playerUid} {
        allow read: if isTravellerReferee(campaignId)
          || (isAuthed() && request.auth.uid == playerUid);
        allow create: if isAuthed()
          && request.auth.uid == playerUid
          && declarationField('uid') == playerUid
          && declarationField('campaignId') == campaignId
          && travellerInviteOpens(declarationField('code'), campaignId);
        allow update: if false;
        allow delete: if isTravellerReferee(campaignId)
          || (isAuthed() && request.auth.uid == playerUid);
      }

      // The full encounter: enemy characteristics, wounds, cover, blow
      // allowances, and every combatant's position. Referee only — a player
      // who could read this would see everything the referee knows.
      match /encounters/{encounterId} {
        allow read, write: if isTravellerReferee(campaignId);

        // What the players are shown, published by the referee's client after
        // each round: names, sides, positions, visible condition, and the
        // narration of what happened. No characteristics, no wound totals.
        match /view/{viewId} {
          allow read: if isAtTravellerTable(campaignId);
          allow write: if isTravellerReferee(campaignId);
        }

        // A declaration is an intent, not state. A player may write one for a
        // combatant they own and for nobody else, may not alter it once made,
        // and may not resolve anything: resolution is the referee's, through
        // the encounter document above.
        match /declarations/{combatantId} {
          allow read: if isAtTravellerTable(campaignId);
          allow create: if isAuthed()
            && declarationField('uid') == request.auth.uid
            && declarationField('actorId') == combatantId
            && ownsTravellerCombatant(campaignId, combatantId);
          allow update: if false;
          allow delete: if isTravellerReferee(campaignId);
        }

        // Token positions are authoritative encounter state. Players submit
        // immutable move intents for owned characters; the referee validates,
        // applies, publishes the safe view, and removes the intent.
        match /moves/{moveId} {
          allow read: if isAtTravellerTable(campaignId);
          allow create: if isAuthed()
            && request.resource.data.keys().hasOnly(['uid', 'encounterId', 'actorId', 'column', 'row', 'pace', 'round', 'movedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.encounterId == encounterId
            && request.resource.data.actorId is string
            && request.resource.data.column is int && request.resource.data.column >= 0 && request.resource.data.column <= 1000
            && request.resource.data.row is int && request.resource.data.row >= 0 && request.resource.data.row <= 1000
            && (request.resource.data.pace == 'walk' || request.resource.data.pace == 'run')
            && request.resource.data.round is int && request.resource.data.round >= 1
            && request.resource.data.movedAt is int
            && ownsTravellerCombatant(campaignId, request.resource.data.actorId);
          allow update: if false;
          allow delete: if isTravellerReferee(campaignId);
        }

        // Selection and targeting are per-user transient presence, not combat
        // authority. A seated user may publish only their own presence record.
        match /presence/{playerUid} {
          allow read: if isAtTravellerTable(campaignId);
          allow create, update: if isTravellerPlayer(campaignId)
            && request.auth.uid == playerUid
            && request.resource.data.keys().hasOnly(['uid', 'selectedIds', 'targetIds', 'updatedAt'])
            && request.resource.data.uid == playerUid
            && request.resource.data.selectedIds is list && request.resource.data.selectedIds.size() <= 20
            && request.resource.data.targetIds is list && request.resource.data.targetIds.size() <= 20
            && request.resource.data.updatedAt is int;
          allow delete: if isTravellerReferee(campaignId) || (isAuthed() && request.auth.uid == playerUid);
        }
      }
    }

    // ── Graycloak Traveller: the player's own characters ───────
    // v13. A character rolled at enter.html, owned by the account that rolled
    // it and carrying where it is: nowhere yet, a referee's campaign, or the
    // solo world. The owner reads, lists, edits and deletes it but may not
    // move it between worlds by hand — a seat is the referee's to give and
    // take — so the world changes only at the hands of the referee of the
    // campaign it is leaving or joining, and they may change nothing else.
    match /travellerCharacters/{characterId} {
      allow read: if isAuthed()
        && resource.data.get('ownerUid', '') == request.auth.uid;
      allow create: if isAuthed()
        && request.resource != null
        && request.resource.data.get('ownerUid', '') == request.auth.uid
        && request.resource.data.get('characterId', '') == characterId
        && request.resource.data.get('world', {}).get('kind', '') == 'unassigned';
      allow update: if isAuthed()
        && request.resource != null
        && (
          (resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('ownerUid', '') == request.auth.uid
            && request.resource.data.get('world', {}) == resource.data.get('world', {}))
          // The referee of the world it is in may move it out (or elsewhere);
          // the referee of the world it is joining may move it in only if its
          // owner has asked to sit down there.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['world', 'pendingJoin', 'updatedAt'])
            && (isTravellerRefereeOfWorld(resource.data.get('world', {}))
              || (isTravellerRefereeOfWorld(request.resource.data.get('world', {}))
                && travellerJoinRequested(request.resource.data.get('world', {}).get('campaignId', ''), resource.data.get('ownerUid', ''), characterId))))
        );
      allow delete: if isAuthed()
        && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    // ── GM roster ──────────────────────────────────────────────
    match /gms/{uid} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ── Base world data ────────────────────────────────────────
    match /regions/{regionId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    match /landmarks/{hexId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ── GM-authored world overlays ─────────────────────────────
    match /subHexes/{docId} {
      allow read: if isAuthed();
      allow write: if isGM();
    }

    match /lakes/{lakeId} {
      allow read: if isAuthed();
      allow write: if isGM();
    }

    match /paths/{pathId} {
      allow read: if isAuthed();
      allow write: if isGM();
    }

    match /mapRegions/{slug} {
      allow read: if isAuthed();
      allow write: if isGM();
    }

    match /settlements/{settlementId} {
      allow read: if isAuthed();
      allow write: if isGM();
    }

    // ── Campaign-scoped entities ───────────────────────────────
    match /entities/{entityId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && (request.resource.data.ownerUid == request.auth.uid
            || isCampaignOwner(request.resource.data.campaignId)
            || isGM());
      allow update, delete: if isAuthed()
        && (resource.data.ownerUid == request.auth.uid
            || isCampaignOwner(resource.data.campaignId)
            || isGM());
    }

    // ── Freeholds ──────────────────────────────────────────────
    match /freeholds/{freeholdId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && (request.resource.data.founderUid == request.auth.uid
            || isCampaignOwner(request.resource.data.campaignId)
            || isGM());
      allow update, delete: if isAuthed()
        && (resource.data.founderUid == request.auth.uid
            || isCampaignOwner(resource.data.campaignId)
            || isGM());
    }

    // ── Player characters / Actors ─────────────────────────────
    // New PCs are still created by the current browser chargen, but they must
    // enter as unbound Actors and may not inject authoritative movement data.
    // Existing Actor authority fields are immutable to ALL browser clients,
    // including owners and GMs. The trusted Admin runtime performs those writes.
    match /characters/{characterId} {
      allow read: if isAuthed();
      allow create: if validClientCharacterCreate();
      allow update: if isAuthed()
        && (resource.data.ownerUid == request.auth.uid
            || isCampaignOwner(resource.data.campaignId)
            || isGM())
        && actorAuthorityFieldsUnchanged();
      allow delete: if isAuthed()
        && (isCampaignOwner(resource.data.campaignId) || isGM());
    }

    // ── Authoritative MMO runtime collections ──────────────────
    // Admin/server SDK only. Server client libraries bypass Security Rules;
    // browsers have no direct read or write path to these collections yet.
    match /activities/{activityId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read, write: if false;
    }

    // ── Deny everything else ───────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
